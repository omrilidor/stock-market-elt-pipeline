# Copy this file to .env and fill in the values: cp .env.example .env
# .env is git-ignored. Never commit real values.

# SEC EDGAR asks every client to identify itself with a name and contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="stock-market-elt-pipeline your-email@example.com"

# FRED API key (free, 32 characters).
# Get one at https://fred.stlouisfed.org/docs/api/api_key.html (sign in -> Request API Key).
FRED_API_KEY=

# Databricks workspace + personal access token, used to upload raw files to the Volume.
# The Databricks SDK reads these two names automatically.
# Host: the URL of your workspace, without a trailing slash or anything after .com
# Token: Databricks -> your profile (top right) -> Settings -> Developer -> Access tokens -> Generate new token.
# https://docs.databricks.com/aws/en/dev-tools/auth/pat
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
